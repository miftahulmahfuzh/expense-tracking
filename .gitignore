# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the ONLY one that is committed
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# scaffolding leftovers
/scaffold-tmp

# generated by scripts/copy-image-compression-worker.mjs (predev/prebuild).
# A build artefact of node_modules: committing it means a stale worker bundle
# surviving a browser-image-compression bump.
/public/vendor/
.env*

# git worktrees created for isolated feature work (see using-git-worktrees skill).
# Nested checkouts of this same repo — tracking them would commit the repo into itself.
/.worktrees/

# Python bytecode from scripts/ (palette-check, glass-backdrop)
__pycache__/
